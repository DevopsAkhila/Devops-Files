// Error Handling + Try and catch block+Variables + Retry and wait time
pipeline{
    agent any
    tools{
        maven 'mymaven'
    }
    stages{
        stage ('Test the code')
        {
            steps{
               // git 'https://github.com/Sonal0409/DevOpsCodeDemo.git' -> if this line is omitted , this pipeline will fail
            script{
                int maxRetries=3
                int retries=0
                boolean success=false
                while(retries<maxRetries && !success){
                    try{
                        sh 'mvn test'  // FAILS
                        success=true
                    }
                    catch(Exception e){
                        retries++
                        echo "Test failed. Retry attempt: ${retries}"
                         sleep(10)  // wait for 10 seconds before retrying
                        if(!success)
                          {
      error("All attempts have failed")
      }
                    }
                }
            }
}
        }
        }
}