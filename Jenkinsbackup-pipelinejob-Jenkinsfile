pipeline{
    agent any
    environment{
        JENKINS_HOME=/var/lib/jenkins
        JENKINS_BACKUP_DIR=/tmp/jenkinsbackup
    }
    stages{
        stage('Creation of backup')
        steps{
            tar -czvf ${{env.JENKINS_HOME}} JENKINS_BACKUP_DIR.tar.gz
        }
    }
    stage('Copy to S3')
    {
        steps{
            aws s3 cp s3://jenkins-server-backup-demo/ jenkinsbackup.tar.gz
        }
    }
    
}