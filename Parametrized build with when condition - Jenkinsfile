pipeline{
    agent any
    tools{
        maven 'mymaven'
    }
    parameters{
        choice(name: 'Env', choices: ["Dev", "QA", " "], description: 'Select the environment')
    }
    stages{
    stage('Build on the dev environment')
    {
    when
{
expression{
params.Env == 'Dev'
}
}
steps{
git 'https://github.com/Sonal0409/DevOpsCodeDemo.git'
sh 'mvn clean package'
}
}

stage ('Build on the QA environment')
{
when
{
expression{
params.Env == 'QA'
}
}
steps{
git 'https://github.com/Sonal0409/DevOpsCodeDemo.git'
sh 'mvn test pmd:pmd'
}
}
}
}