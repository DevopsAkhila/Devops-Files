pipeline{
    agent any
    tools{
        maven 'mymaven'
    }
    stages{
        stage('Clone the repository'){
            steps{
                git 'https://github.com/demo1orgtoday/SonarQubeCoverageJava.git'
            }
        }
        stage('Build'){
            steps{
                sh 'mvn test'
            }
        }
        stage('SonarQube analysis'){
            environment{
                scannerHome = tool 'sonartool'
            }
            steps{
                withSonarQubeEnv('mysonar'){
                    sh '''
                    $scannerHome/bin/sonar-scanner \
                    -Dsonar.organization=devopsakhila \
                    -Dsonar.projectKey=devopsakhila_sonar-cloud-demo \
                    -Dsonar.sources=src/main/java \
                    -Dsonar.tests=src/test/java \
                    -Dsonar.java.binaries=target/classes
                    '''
                }
            }
                post{
                    success{
                        slackSend channel: 'jenkins-demo', message: 'Code analysis completed'
                    }
                    failure{
                        slackSend channel: 'jenkins-demo', message: 'Code analysis failed'
                    }
            }
        }
    }
}