### Example: complete declarative pipeline integrating PMD

```groovy
pipeline {
    agent any

    stages {
        stage('Build') {
            steps {
                sh 'mvn -B -DskipTests clean package'
            }
        }
        stage('PMD') {
            steps {
                // Generate PMD report
                sh 'mvn -B pmd:pmd'
            }
        }
    }

    post {
        always {
            // Publish PMD findings even if the build failed
            recordIssues(
                enabledForFailure: true,
                tools: [pmdParser(pattern: '**/pmd.xml')]
            )
        }
    }
}
```

