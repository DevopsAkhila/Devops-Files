pipeline{
    agent any
    tools {
        maven 'mymaven'
    }
    parameters{
        choice(name: 'ENV', choices: ["Dev", "QA", "prod"], description: 'Select the environment')
    }
    stages{
        stage('Build on Dev environment') {
        steps{
        script{
       def mvnCMD = [
    "Dev" : "compile",
    "QA"  : "test",
    "prod": "clean install"
       ]
        def CMD =mvnCMD[params.ENV]
        git 'https://github.com/Sonal0409/DevOpsCodeDemo.git'
        sh "mvn ${CMD}"
        }
      
        }}
    }
}