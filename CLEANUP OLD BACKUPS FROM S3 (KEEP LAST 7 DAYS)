pipeline {
    agent any

    environment {
        S3_BUCKET = "s3://jenkins-server-backup-demo"
        RETENTION_DAYS = "7"
    }

    stages {

        stage('Cleanup Old Backups') {
            steps {
                sh '''
                aws s3 ls ${S3_BUCKET}/ | while read -r line;
                do
                    fileDate=$(echo $line | awk '{print $1}')
                    fileName=$(echo $line | awk '{print $4}')

                    if [[ ! -z "$fileName" ]]; then
                        fileEpoch=$(date -d "$fileDate" +%s)
                        currentEpoch=$(date +%s)
                        ageDays=$(( (currentEpoch - fileEpoch) / 86400 ))

                        if [ $ageDays -gt ${RETENTION_DAYS} ]; then
                            echo "Deleting $fileName (age: $ageDays days)"
                            aws s3 rm ${S3_BUCKET}/$fileName
                        fi
                    fi
                done
                '''
            }
        }
    }

    post {
        success {
            echo "✅ Old Jenkins backups cleaned successfully"
        }
    }
}
