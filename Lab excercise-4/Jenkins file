pipeline {

    // Jenkins can run this pipeline on any available agent/node
    agent any

    // Tools section ensures Maven is available in the PATH
    tools {
        maven 'mymaven'   // Uses Maven installation named "mymaven" configured in Jenkins
    }

    // Parameters allow user input before the build starts
    parameters {
        choice(
            name: 'BRANCH_TO_BE_BUILD',  // Parameter name used throughout the pipeline
            choices: ['dev', 'main', 'Practice-lab-excercises', 'Jenkins-Demo-files'],
            description: 'Select the branch to build'
        )
    }

    stages {

        // ---------------- CHECKOUT STAGE ----------------
        stage('Checkout Code') {
            steps {
                script {
                    // Validate selected branch before checkout

                    if (params.BRANCH_TO_BE_BUILD == 'main') {
                        // Prevent build for main branch
                        echo "You have selected the main branch. No relevant files found for build."
                        error("Aborting the build as main branch has no buildable files.")
                    } 
                    else if (params.BRANCH_TO_BE_BUILD == 'dev') {
                        // Prevent build for non-existing dev branch
                        echo "You have selected the dev branch. Branch does not exist."
                        error("Aborting the build as dev branch does not exist.")
                    } 
                    else if (params.BRANCH_TO_BE_BUILD == 'Jenkins-Demo-files') {
                        // Prevent build for restricted branch
                        echo "You have selected the Jenkins-Demo-files branch. Branch does not exist."
                        error("Aborting the build as Jenkins-Demo-files branch has no buildable files.")
                    } 
                    else {
                        // Only valid branch reaches this point
                        // Git checkout happens here
                        git branch: "${params.BRANCH_TO_BE_BUILD}",
                            url: 'https://github.com/DevopsAkhila/Devops-Files.git'
                    }
                }
            }
        }

        // ---------------- PARALLEL TEST STAGE ----------------
        stage('Parallel Tests') {

            // Parallel block runs stages simultaneously
            parallel {

                stage('Unit Tests') {
                    steps {
                        // Runs unit tests (mvn test)
                        sh 'mvn -f "Lab excercise-3/pom.xml" test'
                    }
                }

                stage('Integration Tests') {
                    steps {
                        // Runs integration tests + additional checks (verify lifecycle)
                        sh 'mvn -f "Lab excercise-3/pom.xml" verify'
                    }
                }
            }
        }

        // ---------------- MANUAL APPROVAL STAGE ----------------
        stage('Approval Gate') {
            steps {
                // Pauses the pipeline and waits for manual approval
                input(
                    id: 'ApproveToDeploy',
                    message: 'Do you want to proceed to deploy the application?'
                )
            }
        }

        // ---------------- DEPLOY STAGE ----------------
        stage('Deploy Application') {
            steps {
                script {
                    try {
                        // Timeout ensures deployment doesn't run forever
                        timeout(time: 5, unit: 'MINUTES') {

                            echo "Deploying..."

                            // Simulated long-running deployment command
                            // sleep 300 = 5 minutes
                            sh 'sleep 300'
                        }
                    } 
                    catch (err) {
                        // This block catches:
                        // 1) Timeout exceptions
                        // 2) Deployment failures
                        echo "Deployment step timed out or failed: ${err}"

                        // Explicitly fail the build
                        error("Aborting the build due to deployment failure.")
                    }
                }
            }
        }
    }
}
